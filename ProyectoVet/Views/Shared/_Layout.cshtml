<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoVet</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoVet.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Orbes ambientales que refractan luz y color a través del vidrio -->

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg glass-navbar mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="rounded-3 bg-primary bg-opacity-10 p-2 me-2 d-inline-flex align-items-center justify-content-center text-primary" style="width: 38px; height: 38px; border: 1px solid rgba(var(--bs-primary-rgb), 0.2);">
                        <i class="bi bi-heart-pulse-fill fs-5"></i>
                    </span>
                    <span>Proyecto<span class="text-primary">Vet</span></span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        @if (Context.Session.GetString("EmpleadoNombre") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door me-1"></i> Inicio
                                </a>
                            </li>

                            <!-- Módulo Pacientes -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-heart me-1"></i> Pacientes
                                </a>
                                <ul class="dropdown-menu glass-dropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Dueno" asp-action="Index">
                                            <i class="bi bi-people me-2 text-primary"></i> Dueños
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Mascotas" asp-action="Index">
                                            <i class="bi bi-feather me-2 text-primary"></i> Mascotas
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider border-secondary border-opacity-10"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="ExpedientesClinicoes" asp-action="Index">
                                            <i class="bi bi-folder2-open me-2 text-primary"></i> Expedientes Clínicos
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- Módulo Atención Médica -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-hospital me-1"></i> Atención Médica
                                </a>
                                <ul class="dropdown-menu glass-dropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Citas" asp-action="Index">
                                            <i class="bi bi-calendar-event me-2 text-success"></i> Agenda de Citas
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Consultas" asp-action="Index">
                                            <i class="bi bi-clipboard2-pulse me-2 text-success"></i> Consultas Médicas
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- Módulo Administración y Catálogos -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear me-1"></i> Administración
                                </a>
                                <ul class="dropdown-menu glass-dropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Medicamentos" asp-action="Index">
                                            <i class="bi bi-capsule me-2 text-info"></i> Medicamentos
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Especialidades" asp-action="Index">
                                            <i class="bi bi-award me-2 text-info"></i> Especialidades
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider border-secondary border-opacity-10"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Empleadoes" asp-action="Index">
                                            <i class="bi bi-person-badge me-2 text-secondary"></i> Empleados
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Permisoes" asp-action="Index">
                                            <i class="bi bi-shield-lock me-2 text-secondary"></i> Permisos
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    @if (Context.Session.GetString("EmpleadoNombre") != null)
                    {
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                            <li class="nav-item me-2 text-dark fw-semibold">
                                <span class="d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-person-circle text-primary"></i>
                                    @Context.Session.GetString("EmpleadoNombre")
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-secondary btn-sm" asp-controller="Auth" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                                </a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Auth" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container mb-5">
        <!-- Notificaciones Flash / TempData Glass -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-info-circle-fill me-2 fs-5 align-middle"></i> @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer py-3 glass-footer mt-auto">
        <div class="container text-center text-muted small">
            &copy; 2026 - <strong class="text-dark">ProyectoVet</strong> - Sistema de Gestión Veterinaria | <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
