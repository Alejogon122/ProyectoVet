@model ProyectoVet.Models.Empleado

@{
    ViewData["Title"] = "Borrar Empleado";
}

<h1>@ViewData["Title"]</h1>

<h3>¿Confirma que desea borrar este empleado?</h3>
<div>
    <h4>Empleado</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>

        <dt class="col-sm-2">Apellidos</dt>
        <dd class="col-sm-10">@Model.Apellidos</dd>

        <dt class="col-sm-2">Cédula</dt>
        <dd class="col-sm-10">@Model.NumeroCedula</dd>

        <dt class="col-sm-2">Rol</dt>
        <dd class="col-sm-10">@Model.IdRolNavigation?.NombreRol</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="IdEmpleado" />
    <button type="submit" class="btn btn-danger">Borrar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
