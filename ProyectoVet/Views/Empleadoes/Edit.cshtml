@model ProyectoVet.Models.Empleado

@{
    ViewData["Title"] = "Editar Empleado";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
    <input type="hidden" asp-for="IdEmpleado" />
    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Apellidos"></label>
        <input asp-for="Apellidos" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="NumeroCedula"></label>
        <input asp-for="NumeroCedula" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Telefono"></label>
        <input asp-for="Telefono" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="CorreoElectronico"></label>
        <input asp-for="CorreoElectronico" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Contrasena"></label>
        <input id="Contrasena" name="Contrasena" class="form-control" type="password" autocomplete="new-password" />
        <p class="form-text">Deja la contraseña vacía para conservar la actual.</p>
    </div>
    <div class="form-group">
        <label asp-for="IdRol">Rol</label>
        <select asp-for="IdRol" class="form-control" asp-items="@(ViewData["IdRol"] as SelectList)"></select>
        <p class="form-text">Veterinario: atención clínica. Secretaria: citas, dueños y mascotas. Recepcionista tiene el mismo acceso que Secretaria.</p>
    </div>
    <div class="form-group form-check">
        <input asp-for="Activo" class="form-check-input" />
        <label asp-for="Activo" class="form-check-label"></label>
    </div>
    <div class="form-group">
        <label asp-for="FechaContratacion"></label>
        <input asp-for="FechaContratacion" class="form-control" type="date" />
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
