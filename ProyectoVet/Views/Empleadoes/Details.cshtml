@model ProyectoVet.Models.Empleado

@{
    ViewData["Title"] = "Detalle Empleado";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Empleado</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>

        <dt class="col-sm-2">Apellidos</dt>
        <dd class="col-sm-10">@Model.Apellidos</dd>

        <dt class="col-sm-2">Cédula</dt>
        <dd class="col-sm-10">@Model.NumeroCedula</dd>

        <dt class="col-sm-2">Teléfono</dt>
        <dd class="col-sm-10">@Model.Telefono</dd>

        <dt class="col-sm-2">Correo</dt>
        <dd class="col-sm-10">@Model.CorreoElectronico</dd>

        <dt class="col-sm-2">Rol</dt>
        <dd class="col-sm-10">@Model.IdRolNavigation?.NombreRol</dd>

        <dt class="col-sm-2">Activo</dt>
        <dd class="col-sm-10">@(Model.Activo ? "Sí" : "No")</dd>

        <dt class="col-sm-2">Fecha Contratación</dt>
        <dd class="col-sm-10">@(Model.FechaContratacion.HasValue ? Model.FechaContratacion.Value.ToString("yyyy-MM-dd") : "")</dd>
    </dl>
</div>

<p>
    <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.IdEmpleado">Editar</a>
    <a class="btn btn-primary" asp-action="Index">Volver al listado</a>
</p>
