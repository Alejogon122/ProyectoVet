@model IEnumerable<ProyectoVet.Models.Empleado>

@{
    ViewData["Title"] = "Listado de Empleados";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Crear nuevo</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellidos</th>
            <th>Cédula</th>
            <th>Teléfono</th>
            <th>Correo</th>
            <th>Rol</th>
            <th>Activo</th>
            <th>Fecha Contratación</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Nombre</td>
            <td>@item.Apellidos</td>
            <td>@item.NumeroCedula</td>
            <td>@item.Telefono</td>
            <td>@item.CorreoElectronico</td>
            <td>@item.IdRolNavigation?.NombreRol</td>
            <td>@(item.Activo ? "Sí" : "No")</td>
            <td>@(item.FechaContratacion.HasValue ? item.FechaContratacion.Value.ToString("yyyy-MM-dd") : "")</td>
            <td>
                <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.IdEmpleado">Detalles</a>
                <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.IdEmpleado">Editar</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.IdEmpleado">Borrar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
