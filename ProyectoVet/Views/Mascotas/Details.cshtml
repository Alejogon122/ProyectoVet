@model ProyectoVet.Models.Mascota

@{
    ViewData["Title"] = "Detalles Mascota";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Mascota</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.NombreMascota</dd>

        <dt class="col-sm-2">Clase</dt>
        <dd class="col-sm-10">@Model.ClaseAnimal @Model.OtraClaseAnimal</dd>

        <dt class="col-sm-2">Raza</dt>
        <dd class="col-sm-10">@Model.Raza</dd>

        <dt class="col-sm-2">Sexo</dt>
        <dd class="col-sm-10">@Model.Sexo</dd>

        <dt class="col-sm-2">Fecha Nac.</dt>
        <dd class="col-sm-10">@(Model.FechaNacimiento.HasValue ? Model.FechaNacimiento.Value.ToString("yyyy-MM-dd") : "")</dd>

        <dt class="col-sm-2">Color</dt>
        <dd class="col-sm-10">@Model.Color</dd>

        <dt class="col-sm-2">Microchip</dt>
        <dd class="col-sm-10">@Model.NumeroMicrochip</dd>

        <dt class="col-sm-2">Dueño</dt>
        <dd class="col-sm-10">@Model.IdDuenoNavigation?.Nombre @Model.IdDuenoNavigation?.Apellidos</dd>

        <dt class="col-sm-2">Activo</dt>
        <dd class="col-sm-10">@(Model.Activa ? "Sí" : "No")</dd>

        <dt class="col-sm-2">Observaciones</dt>
        <dd class="col-sm-10">@Model.Observaciones</dd>
    </dl>
</div>

<p>
    <a class="btn btn-secondary" asp-action="Index">Volver al listado</a>
    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.IdMascota">Editar</a>
</p>
