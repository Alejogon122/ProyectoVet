@model ProyectoVet.Models.Mascota

@{
    ViewData["Title"] = "Borrar Mascota";
}

<h1>@ViewData["Title"]</h1>

<h3>¿Está seguro de que desea borrar esta mascota?</h3>
<div>
    <h4>Mascota</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.NombreMascota</dd>
        <dt class="col-sm-2">Dueño</dt>
        <dd class="col-sm-10">@Model.IdDuenoNavigation?.Nombre @Model.IdDuenoNavigation?.Apellidos</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="IdMascota" />
    <button type="submit" class="btn btn-danger">Borrar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
