@model ProyectoVet.Models.Mascota

@{
    ViewData["Title"] = "Crear Mascota";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="NombreMascota"></label>
        <input asp-for="NombreMascota" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="ClaseAnimal"></label>
        <input asp-for="ClaseAnimal" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="OtraClaseAnimal"></label>
        <input asp-for="OtraClaseAnimal" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Raza"></label>
        <input asp-for="Raza" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Sexo"></label>
        <input asp-for="Sexo" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="FechaNacimiento"></label>
        <input asp-for="FechaNacimiento" class="form-control" type="date" />
    </div>
    <div class="form-group">
        <label asp-for="Color"></label>
        <input asp-for="Color" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="NumeroMicrochip"></label>
        <input asp-for="NumeroMicrochip" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="IdDueno">Dueño</label>
        <select asp-for="IdDueno" asp-items="@((SelectList)ViewData["IdDueno"])" class="form-control"></select>
    </div>
    <div class="form-group form-check">
        <input asp-for="Activa" class="form-check-input" />
        <label asp-for="Activa" class="form-check-label"></label>
    </div>
    <div class="form-group">
        <label asp-for="Observaciones"></label>
        <textarea asp-for="Observaciones" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Crear</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
