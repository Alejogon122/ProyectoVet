@model IEnumerable<ProyectoVet.Models.Mascota>

@{
    ViewData["Title"] = "Listado de Mascotas";
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="card-title fw-bold text-dark mb-0">
                <i class="bi bi-feather text-primary me-2"></i> Pacientes (Mascotas)
            </h4>
            <small class="text-muted">Registro de mascotas atendidas en la clínica veterinaria.</small>
        </div>
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-circle me-1"></i> Registrar Mascota
        </a>
    </div>

    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Especie / Raza</th>
                            <th>Sexo</th>
                            <th>Fecha Nac.</th>
                            <th>Dueño Responsable</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">
                                    <i class="bi bi-paw me-1 text-primary"></i> @item.NombreMascota
                                </div>
                                <small class="text-muted">@(string.IsNullOrEmpty(item.Color) ? "" : $"Color: {item.Color}")</small>
                            </td>
                            <td>
                                <span class="fw-semibold">@item.ClaseAnimal @(string.IsNullOrEmpty(item.OtraClaseAnimal) ? "" : $"({item.OtraClaseAnimal})")</span><br />
                                <small class="text-muted">@(string.IsNullOrEmpty(item.Raza) ? "Mestizo / Sin raza" : item.Raza)</small>
                            </td>
                            <td>
                                @if (item.Sexo == "Macho")
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border"><i class="bi bi-gender-male"></i> Macho</span>
                                }
                                else if (item.Sexo == "Hembra")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border"><i class="bi bi-gender-female"></i> Hembra</span>
                                }
                                else
                                {
                                    <span class="text-muted small">N/A</span>
                                }
                            </td>
                            <td>
                                @(item.FechaNacimiento.HasValue ? item.FechaNacimiento.Value.ToString("dd/MM/yyyy") : "No registrada")
                            </td>
                            <td>
                                <span class="fw-semibold">@item.IdDuenoNavigation?.Nombre @item.IdDuenoNavigation?.Apellidos</span><br />
                                <small class="text-muted"><i class="bi bi-telephone me-1"></i> @(item.IdDuenoNavigation?.Telefono ?? "Sin tel.")</small>
                            </td>
                            <td>
                                @if (item.Activa)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@item.IdMascota" title="Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-warning" asp-action="Edit" asp-route-id="@item.IdMascota" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdMascota" title="Borrar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-paw text-muted fs-1 mb-2"></i>
                <p class="text-muted">No se encontraron mascotas registradas.</p>
                <a class="btn btn-outline-primary btn-sm" asp-action="Create">Registrar la primera mascota</a>
            </div>
        }
    </div>
</div>
