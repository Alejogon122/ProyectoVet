@model ProyectoVet.Models.Especialidade

@{
    ViewData["Title"] = "Crear Especialidad";
}

<h1>Crear Especialidad</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="NombreEspecialidad" class="control-label"></label>
        <input asp-for="NombreEspecialidad" class="form-control" />
        <span asp-validation-for="NombreEspecialidad" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Descripcion" class="control-label"></label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <div class="form-group mt-2">
        <input type="submit" value="Crear" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
