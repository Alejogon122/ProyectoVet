@model IEnumerable<ProyectoVet.Models.Cita>
@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Próximas citas programadas</caption>
            <thead><tr><th scope="col">Fecha y hora</th><th scope="col">Paciente</th><th scope="col">Veterinario</th><th scope="col">Estado</th><th scope="col">Acción</th></tr></thead>
            <tbody>
            @foreach (var cita in Model)
            {
                <tr>
                    <td class="text-nowrap">@cita.FechaHoraInicio.ToString("dd/MM/yyyy")<br /><small>@cita.FechaHoraInicio.ToString("HH:mm")</small></td>
                    <td>@cita.IdMascotaNavigation?.NombreMascota</td>
                    <td>@cita.IdEmpleadoNavigation?.Nombre @cita.IdEmpleadoNavigation?.Apellidos</td>
                    <td>@cita.EstadoCita</td>
                    <td><a asp-controller="Citas" asp-action="Details" asp-route-id="@cita.IdCita" class="btn btn-sm btn-outline-primary" aria-label="Ver cita de @cita.IdMascotaNavigation?.NombreMascota">Ver cita</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted p-4 mb-0" role="status">No hay próximas citas para mostrar.</p>
}
