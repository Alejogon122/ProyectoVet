@model ProyectoVet.Models.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Panel del veterinario"; }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">Atención clínica · Veterinario</p>
        <h1 class="h2 fw-bold">Hola, @User.Identity?.Name</h1>
        <p class="text-muted mb-0">Revisa tu agenda y continúa la atención de tus pacientes.</p>
    </div>
    <a asp-controller="Consultas" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Registrar consulta</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-sm-4"><div class="glass-card p-3 h-100"><p class="text-muted mb-1">Mis citas de hoy</p><p class="h2 mb-0">@Model.TotalCitasHoy</p></div></div>
    <div class="col-sm-4"><div class="glass-card p-3 h-100"><p class="text-muted mb-1">Pacientes activos de la clínica</p><p class="h2 mb-0">@Model.TotalMascotas</p></div></div>
    <div class="col-sm-4"><div class="glass-card p-3 h-100"><p class="text-muted mb-1">Consultas de la clínica</p><p class="h2 mb-0">@Model.TotalConsultas</p></div></div>
</div>
<div class="row g-4">
    <section class="col-lg-8" aria-labelledby="agenda-title">
        <div class="glass-card overflow-hidden">
            <div class="p-3 border-bottom"><h2 id="agenda-title" class="h5 mb-1">Mi próxima agenda</h2><p class="small text-muted mb-0">Hasta 7 citas asignadas, desde hoy.</p></div>
            <partial name="_AgendaRol" model="Model.ProximasCitas" />
        </div>
    </section>
    <section class="col-lg-4" aria-labelledby="clinical-title">
        <div class="glass-card p-3">
            <h2 id="clinical-title" class="h5 mb-3">Historia clínica</h2>
            <div class="d-grid gap-2">
                <a asp-controller="ExpedientesClinicoes" asp-action="Index" class="btn btn-outline-primary text-start">Consultar expedientes</a>
                <a asp-controller="Consultas" asp-action="Index" class="btn btn-outline-primary text-start">Historial de consultas</a>
                <a asp-controller="Medicamentos" asp-action="Index" class="btn btn-outline-secondary text-start">Consultar medicamentos</a>
                <a asp-controller="Mascotas" asp-action="Index" class="btn btn-outline-secondary text-start">Buscar paciente</a>
            </div>
        </div>
    </section>
</div>
