@model ProyectoVet.Models.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Panel de secretaría"; }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">Recepción · Secretaria</p>
        <h1 class="h2 fw-bold">Hola, @User.Identity?.Name</h1>
        <p class="text-muted mb-0">Organiza las citas y mantén al día los datos de pacientes y dueños.</p>
    </div>
    <a asp-controller="Citas" asp-action="Create" class="btn btn-primary"><i class="bi bi-calendar-plus me-2" aria-hidden="true"></i>Agendar cita</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-sm-4"><div class="glass-card p-3 h-100"><p class="text-muted mb-1">Citas de hoy</p><p class="h2 mb-0">@Model.TotalCitasHoy</p></div></div>
    <div class="col-sm-4"><div class="glass-card p-3 h-100"><p class="text-muted mb-1">Pacientes activos</p><p class="h2 mb-0">@Model.TotalMascotas</p></div></div>
    <div class="col-sm-4"><div class="glass-card p-3 h-100"><p class="text-muted mb-1">Dueños activos</p><p class="h2 mb-0">@Model.TotalDuenos</p></div></div>
</div>
<div class="row g-4">
    <section class="col-lg-8" aria-labelledby="agenda-title">
        <div class="glass-card overflow-hidden">
            <div class="p-3 border-bottom"><h2 id="agenda-title" class="h5 mb-1">Próximas citas de la clínica</h2><p class="small text-muted mb-0">Hasta 7 citas, desde hoy.</p></div>
            <partial name="_AgendaRol" model="Model.ProximasCitas" />
        </div>
    </section>
    <section class="col-lg-4" aria-labelledby="reception-title">
        <div class="glass-card p-3">
            <h2 id="reception-title" class="h5 mb-3">Atención en recepción</h2>
            <div class="d-grid gap-2">
                <a asp-controller="Dueno" asp-action="Create" class="btn btn-outline-primary text-start">Registrar dueño</a>
                <a asp-controller="Mascotas" asp-action="Create" class="btn btn-outline-primary text-start">Registrar mascota</a>
                <a asp-controller="Citas" asp-action="Index" class="btn btn-outline-secondary text-start">Gestionar agenda</a>
                <a asp-controller="Mascotas" asp-action="Index" class="btn btn-outline-secondary text-start">Buscar paciente</a>
            </div>
        </div>
    </section>
</div>
