@model ProyectoVet.Models.ExpedientesClinico

@{
    ViewData["Title"] = "Editar expediente";
}

<h1>Editar expediente</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="IdExpediente" />
    <div class="form-group">
        <label asp-for="IdMascota">Mascota</label>
        <select asp-for="IdMascota" asp-items="@((SelectList)ViewData["IdMascota"])" class="form-control"></select>
    </div>
    <div class="form-group">
        <label asp-for="FechaApertura"></label>
        <input asp-for="FechaApertura" class="form-control" type="datetime-local" />
    </div>
    <div class="form-group">
        <label asp-for="Alergias"></label>
        <input asp-for="Alergias" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Antecedentes"></label>
        <textarea asp-for="Antecedentes" class="form-control"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="ObservacionesGenerales"></label>
        <textarea asp-for="ObservacionesGenerales" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
