@model ProyectoVet.Models.ExpedientesClinico

@{
    ViewData["Title"] = "Editar Expediente Clínico";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card glass-card border-0 shadow-sm rounded-4">
            <div class="card-header border-0 py-3">
                <h4 class="card-title fw-bold text-dark mb-0">
                    <i class="bi bi-pencil-square text-warning me-2"></i> Editar Expediente Clínico #@Model.IdExpediente
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="IdExpediente" />
                    <div asp-validation-summary="All" class="alert alert-danger py-2 px-3 mb-3 small" role="alert" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label asp-for="IdMascota" class="form-label fw-semibold">Paciente (Mascota y Dueño) *</label>
                            <select asp-for="IdMascota" asp-items="ViewBag.IdMascota" class="form-select" required></select>
                            <span asp-validation-for="IdMascota" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="FechaApertura" class="form-label fw-semibold">Fecha de Apertura *</label>
                            <input asp-for="FechaApertura" class="form-control" type="datetime-local" required />
                            <span asp-validation-for="FechaApertura" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Alergias" class="form-label fw-semibold">Alergias Conocidas</label>
                            <input asp-for="Alergias" class="form-control" placeholder="Alergia a fármacos, alimentos, etc. (o 'Ninguna conocida')" />
                            <span asp-validation-for="Alergias" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Antecedentes" class="form-label fw-semibold">Antecedentes Médicos / Quirúrgicos</label>
                            <textarea asp-for="Antecedentes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Antecedentes" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ObservacionesGenerales" class="form-label fw-semibold">Observaciones Generales</label>
                            <textarea asp-for="ObservacionesGenerales" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="ObservacionesGenerales" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
