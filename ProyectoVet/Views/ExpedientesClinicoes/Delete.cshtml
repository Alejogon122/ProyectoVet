@model ProyectoVet.Models.ExpedientesClinico

@{
    ViewData["Title"] = "Eliminar expediente";
}

<h1>Eliminar expediente</h1>

<h3>¿Está seguro que desea eliminar este elemento?</h3>
<div>
    <h4>Expediente</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.IdExpediente</dd>

        <dt class="col-sm-2">Mascota</dt>
        <dd class="col-sm-10">@Model.IdMascotaNavigation?.NombreMascota</dd>

        <dt class="col-sm-2">Fecha apertura</dt>
        <dd class="col-sm-10">@Model.FechaApertura</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="IdExpediente" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div>
