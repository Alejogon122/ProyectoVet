@model ProyectoVet.Models.ExpedientesClinico

@{
    ViewData["Title"] = "Abrir Expediente Clínico";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card glass-card border-0 shadow-sm rounded-4">
            <div class="card-header border-0 py-3">
                <h4 class="card-title fw-bold text-dark mb-0">
                    <i class="bi bi-folder-plus text-primary me-2"></i> Apertura de Expediente Clínico
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger py-2 px-3 mb-3 small" role="alert" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

                    @if (ViewBag.NoHayMascotasDisponibles == true)
                    {
                        <div class="alert alert-info d-flex align-items-center justify-content-between p-3 rounded-3" role="alert">
                            <div>
                                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                                <span>Todas las mascotas activas registradas ya cuentan con su respectivo expediente clínico.</span>
                            </div>
                            <a asp-controller="Mascotas" asp-action="Create" class="btn btn-sm btn-primary ms-3 text-nowrap">
                                <i class="bi bi-plus-circle me-1"></i> Registrar Nueva Mascota
                            </a>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label asp-for="IdMascota" class="form-label fw-semibold">Paciente (Mascota y Dueño) *</label>
                            <select asp-for="IdMascota" asp-items="ViewBag.IdMascota" class="form-select" required>
                                <option value="">-- Seleccione una mascota disponible --</option>
                            </select>
                            <span asp-validation-for="IdMascota" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="FechaApertura" class="form-label fw-semibold">Fecha de Apertura *</label>
                            <input asp-for="FechaApertura" class="form-control" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                            <span asp-validation-for="FechaApertura" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Alergias" class="form-label fw-semibold">Alergias Conocidas</label>
                            <input asp-for="Alergias" class="form-control" placeholder="Alergia a fármacos, alimentos, etc. (o 'Ninguna conocida')" />
                            <span asp-validation-for="Alergias" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Antecedentes" class="form-label fw-semibold">Antecedentes Médicos / Quirúrgicos</label>
                            <textarea asp-for="Antecedentes" class="form-control" rows="3" placeholder="Cirugías previas, enfermedades crónicas, vacunas previas..."></textarea>
                            <span asp-validation-for="Antecedentes" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ObservacionesGenerales" class="form-label fw-semibold">Observaciones Generales</label>
                            <textarea asp-for="ObservacionesGenerales" class="form-control" rows="2" placeholder="Notas adicionales sobre el paciente"></textarea>
                            <span asp-validation-for="ObservacionesGenerales" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary px-4" @(ViewBag.NoHayMascotasDisponibles == true ? "disabled" : "")>
                            <i class="bi bi-folder-check me-1"></i> Abrir Expediente
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
