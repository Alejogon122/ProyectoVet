@model ProyectoVet.Models.Dueno

@{
    ViewData["Title"] = "Eliminar Dueño";
}

<h1>@ViewData["Title"]</h1>

<h4>¿Seguro que desea eliminar este dueño?</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">Apellidos</dt>
    <dd class="col-sm-10">@Model.Apellidos</dd>

    <dt class="col-sm-2">Cédula</dt>
    <dd class="col-sm-10">@Model.NumeroCedula</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdDueno" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
