@model ProyectoVet.Models.Dueno

@{
    ViewData["Title"] = "Detalles del Dueño";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Dueño</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>

        <dt class="col-sm-2">Apellidos</dt>
        <dd class="col-sm-10">@Model.Apellidos</dd>

        <dt class="col-sm-2">Cédula</dt>
        <dd class="col-sm-10">@Model.NumeroCedula</dd>

        <dt class="col-sm-2">Teléfono</dt>
        <dd class="col-sm-10">@Model.Telefono</dd>

        <dt class="col-sm-2">Teléfono Opcional</dt>
        <dd class="col-sm-10">@Model.TelefonoOpcional</dd>

        <dt class="col-sm-2">Correo</dt>
        <dd class="col-sm-10">@Model.CorreoElectronico</dd>

        <dt class="col-sm-2">Fecha Registro</dt>
        <dd class="col-sm-10">@Model.FechaRegistro.ToString("g")</dd>

        <dt class="col-sm-2">Activo</dt>
        <dd class="col-sm-10">@(Model.Activo ? "Sí" : "No")</dd>
    </dl>

    <a class="btn btn-secondary" asp-action="Index">Volver al listado</a>
    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.IdDueno">Editar</a>
</div>
