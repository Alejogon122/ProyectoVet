@model ProyectoVet.Models.Permiso

@{
    ViewData["Title"] = "Eliminar Permiso";
}

<h1>Eliminar Permiso</h1>

<h3>¿Está seguro de que desea eliminar este elemento?</h3>
<div>
    <h4>Permiso</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Nombre
        </dt>
        <dd class = "col-sm-10">
            @Model.NombrePermiso
        </dd>
        <dt class = "col-sm-2">
            Descripción
        </dt>
        <dd class = "col-sm-10">
            @Model.Descripcion
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="IdPermiso" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
