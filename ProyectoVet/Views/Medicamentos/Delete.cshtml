@model ProyectoVet.Models.Medicamento

@{
    ViewData["Title"] = "Eliminar Medicamento";
}

<h1>Eliminar Medicamento</h1>

<h3>¿Está seguro que desea eliminar este elemento?</h3>
<div>
    <h4>Medicamento</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.NombreMedicamento</dd>
        <dt class="col-sm-2">Principio activo</dt>
        <dd class="col-sm-10">@Model.PrincipioActivo</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="IdMedicamento" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div>
