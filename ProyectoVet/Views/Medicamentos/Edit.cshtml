@model ProyectoVet.Models.Medicamento

@{
    ViewData["Title"] = "Editar Medicamento";
}

<h1>Editar Medicamento</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="IdMedicamento" />
    <div class="form-group">
        <label asp-for="NombreMedicamento"></label>
        <input asp-for="NombreMedicamento" class="form-control" />
        <span asp-validation-for="NombreMedicamento" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PrincipioActivo"></label>
        <input asp-for="PrincipioActivo" class="form-control" />
        <span asp-validation-for="PrincipioActivo" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Presentacion"></label>
        <input asp-for="Presentacion" class="form-control" />
        <span asp-validation-for="Presentacion" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Concentracion"></label>
        <input asp-for="Concentracion" class="form-control" />
        <span asp-validation-for="Concentracion" class="text-danger"></span>
    </div>
    <div class="form-check">
        <input asp-for="Activo" class="form-check-input" />
        <label asp-for="Activo" class="form-check-label"></label>
    </div>
    <div class="form-group">
        <label asp-for="Observaciones"></label>
        <textarea asp-for="Observaciones" class="form-control"></textarea>
        <span asp-validation-for="Observaciones" class="text-danger"></span>
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>

<partial name="_ValidationScriptsPartial" />
