@model IEnumerable<ProyectoVet.Models.Medicamento>

@{
    ViewData["Title"] = "Medicamentos";
}

<h1>Medicamentos</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Crear nuevo</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Principio activo</th>
            <th>Presentación</th>
            <th>Concentración</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.NombreMedicamento</td>
            <td>@item.PrincipioActivo</td>
            <td>@item.Presentacion</td>
            <td>@item.Concentracion</td>
            <td>@item.Activo</td>
            <td>
                <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.IdMedicamento">Detalles</a>
                <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@item.IdMedicamento">Editar</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.IdMedicamento">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
