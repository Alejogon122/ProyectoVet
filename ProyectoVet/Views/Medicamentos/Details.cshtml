@model ProyectoVet.Models.Medicamento

@{
    ViewData["Title"] = "Detalles Medicamento";
}

<h1>Detalles</h1>

<div>
    <h4>Medicamento</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.NombreMedicamento</dd>

        <dt class="col-sm-2">Principio activo</dt>
        <dd class="col-sm-10">@Model.PrincipioActivo</dd>

        <dt class="col-sm-2">Presentación</dt>
        <dd class="col-sm-10">@Model.Presentacion</dd>

        <dt class="col-sm-2">Concentración</dt>
        <dd class="col-sm-10">@Model.Concentracion</dd>

        <dt class="col-sm-2">Activo</dt>
        <dd class="col-sm-10">@Model.Activo</dd>

        <dt class="col-sm-2">Observaciones</dt>
        <dd class="col-sm-10">@Model.Observaciones</dd>
    </dl>

    <a class="btn btn-secondary" asp-action="Index">Volver</a>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdMedicamento">Editar</a>
</div>
