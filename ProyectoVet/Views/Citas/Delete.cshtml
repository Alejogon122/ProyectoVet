@model ProyectoVet.Models.Cita

@{
    ViewData["Title"] = "Borrar Cita";
}

<h1>@ViewData["Title"]</h1>

<h3>¿Confirma que desea borrar esta cita?</h3>
<div>
    <h4>Cita</h4>
    <dl class="row">
        <dt class="col-sm-2">Mascota</dt>
        <dd class="col-sm-10">@Model.IdMascotaNavigation?.NombreMascota</dd>

        <dt class="col-sm-2">Empleado</dt>
        <dd class="col-sm-10">@Model.IdEmpleadoNavigation?.Nombre</dd>

        <dt class="col-sm-2">Inicio</dt>
        <dd class="col-sm-10">@Model.FechaHoraInicio.ToString("g")</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Model.EstadoCita</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="IdCita" />
        <button type="submit" class="btn btn-danger">Borrar</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div>
