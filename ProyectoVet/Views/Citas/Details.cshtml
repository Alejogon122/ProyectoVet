@model ProyectoVet.Models.Cita

@{
    ViewData["Title"] = "Detalles de Cita";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Cita</h4>
    <dl class="row">
        <dt class="col-sm-2">Mascota</dt>
        <dd class="col-sm-10">@Model.IdMascotaNavigation?.NombreMascota</dd>

        <dt class="col-sm-2">Empleado</dt>
        <dd class="col-sm-10">@Model.IdEmpleadoNavigation?.Nombre</dd>

        <dt class="col-sm-2">Inicio</dt>
        <dd class="col-sm-10">@Model.FechaHoraInicio.ToString("g")</dd>

        <dt class="col-sm-2">Fin</dt>
        <dd class="col-sm-10">@Model.FechaHoraFin.ToString("g")</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@Model.EstadoCita</dd>

        <dt class="col-sm-2">Motivo</dt>
        <dd class="col-sm-10">@Model.Motivo</dd>

        <dt class="col-sm-2">Observaciones</dt>
        <dd class="col-sm-10">@Model.Observaciones</dd>
    </dl>
    <a class="btn btn-secondary" asp-action="Index">Volver al listado</a>
    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.IdCita">Editar</a>
</div>
