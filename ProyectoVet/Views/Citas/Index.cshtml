@model IEnumerable<ProyectoVet.Models.Cita>

@{
    ViewData["Title"] = "Agenda de Citas";
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="card-title fw-bold text-dark mb-0">
                <i class="bi bi-calendar-event text-primary me-2"></i> Agenda de Citas
            </h4>
            <small class="text-muted">Gestione las citas programadas para atención veterinaria.</small>
        </div>
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-calendar-plus me-1"></i> Agendar Cita
        </a>
    </div>

    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha y Horario</th>
                            <th>Paciente (Mascota)</th>
                            <th>Dueño</th>
                            <th>Veterinario</th>
                            <th>Motivo</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        string badgeClass = item.EstadoCita switch
                        {
                            "Pendiente" => "bg-warning text-dark",
                            "Confirmada" => "bg-info text-dark",
                            "En Atención" => "bg-primary",
                            "Completada" => "bg-success",
                            "Cancelada" => "bg-danger",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td>
                                <span class="fw-semibold text-dark">@item.FechaHoraInicio.ToString("dd/MM/yyyy")</span><br />
                                <small class="text-muted">@item.FechaHoraInicio.ToString("hh:mm tt") - @item.FechaHoraFin.ToString("hh:mm tt")</small>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">
                                    <i class="bi bi-paw me-1 text-primary"></i> @(item.IdMascotaNavigation?.NombreMascota ?? "N/A")
                                </div>
                                <small class="text-muted">@(item.IdMascotaNavigation?.ClaseAnimal ?? "") @(string.IsNullOrEmpty(item.IdMascotaNavigation?.Raza) ? "" : $"• {item.IdMascotaNavigation?.Raza}")</small>
                            </td>
                            <td>
                                <span>@(item.IdMascotaNavigation?.IdDuenoNavigation?.Nombre) @(item.IdMascotaNavigation?.IdDuenoNavigation?.Apellidos)</span><br />
                                <small class="text-muted"><i class="bi bi-telephone me-1"></i> @(item.IdMascotaNavigation?.IdDuenoNavigation?.Telefono ?? "Sin tel.")</small>
                            </td>
                            <td>
                                <span class="fw-semibold">Dr(a). @item.IdEmpleadoNavigation?.Nombre @item.IdEmpleadoNavigation?.Apellidos</span>
                            </td>
                            <td>
                                <span class="text-truncate d-inline-block" style="max-width: 180px;" title="@item.Motivo">
                                    @(string.IsNullOrEmpty(item.Motivo) ? "Consulta general" : item.Motivo)
                                </span>
                            </td>
                            <td>
                                <span class="badge @badgeClass">@item.EstadoCita</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@item.IdCita" title="Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-warning" asp-action="Edit" asp-route-id="@item.IdCita" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdCita" title="Borrar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x text-muted fs-1 mb-2"></i>
                <p class="text-muted">No se encontraron citas registradas.</p>
                <a class="btn btn-outline-primary btn-sm" asp-action="Create">Agendar la primera cita</a>
            </div>
        }
    </div>
</div>
