@model IEnumerable<ProyectoVet.Models.Consulta>

@{
    ViewData["Title"] = "Consultas";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Crear Consulta</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Fecha</th>
            <th>Motivo</th>
            <th>Expediente</th>
            <th>Veterinario</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
    <tr>
        <td>@item.IdConsulta</td>
        <td>@item.FechaConsulta.ToString("g")</td>
        <td>@item.MotivoConsulta</td>
        <td>@item.IdExpediente</td>
        <td>@item.IdVeterinario</td>
        <td>
            <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.IdConsulta">Detalles</a>
            <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@item.IdConsulta">Editar</a>
            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.IdConsulta">Eliminar</a>
        </td>
    </tr>
}
    </tbody>
</table>
