@model IEnumerable<ProyectoVet.Models.Consulta>

@{
    ViewData["Title"] = "Consultas Médicas";
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="card-title fw-bold text-dark mb-0">
                <i class="bi bi-clipboard2-pulse text-success me-2"></i> Historial de Consultas Médicas
            </h4>
            <small class="text-muted">Registro de consultas, diagnósticos y tratamientos realizados.</small>
        </div>
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-circle me-1"></i> Nueva Consulta
        </a>
    </div>

    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Paciente (Mascota)</th>
                            <th>Dueño</th>
                            <th>Veterinario</th>
                            <th>Motivo / Diagnóstico</th>
                            <th>Constantes</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        var mascota = item.IdExpedienteNavigation?.IdMascotaNavigation;
                        var dueno = mascota?.IdDuenoNavigation;

                        <tr>
                            <td>
                                <span class="fw-semibold text-dark">@item.FechaConsulta.ToString("dd/MM/yyyy")</span><br />
                                <small class="text-muted">@item.FechaConsulta.ToString("hh:mm tt")</small>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">
                                    <i class="bi bi-paw me-1 text-primary"></i> @(mascota?.NombreMascota ?? $"Exp. #{item.IdExpediente}")
                                </div>
                                <small class="text-muted">@(mascota?.ClaseAnimal ?? "") @(string.IsNullOrEmpty(mascota?.Raza) ? "" : $"• {mascota.Raza}")</small>
                            </td>
                            <td>
                                <span>@(dueno != null ? $"{dueno.Nombre} {dueno.Apellidos}" : "N/A")</span><br />
                                <small class="text-muted"><i class="bi bi-telephone me-1"></i> @(dueno?.Telefono ?? "Sin tel.")</small>
                            </td>
                            <td>
                                <span class="fw-semibold">Dr(a). @item.IdVeterinarioNavigation?.Nombre @item.IdVeterinarioNavigation?.Apellidos</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark text-truncate" style="max-width: 200px;" title="@item.MotivoConsulta">
                                    @item.MotivoConsulta
                                </div>
                                <small class="text-muted text-truncate d-block" style="max-width: 200px;" title="@item.Diagnostico">
                                    @(string.IsNullOrEmpty(item.Diagnostico) ? "Sin diagnóstico registrado" : $"Diag: {item.Diagnostico}")
                                </small>
                            </td>
                            <td>
                                <small class="d-block text-muted">
                                    <i class="bi bi-speedometer2 me-1"></i> @(item.PesoKg.HasValue ? $"{item.PesoKg} kg" : "---")
                                </small>
                                <small class="d-block text-muted">
                                    <i class="bi bi-thermometer-half me-1"></i> @(item.TemperaturaC.HasValue ? $"{item.TemperaturaC} °C" : "---")
                                </small>
                            </td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@item.IdConsulta" title="Ver Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-warning" asp-action="Edit" asp-route-id="@item.IdConsulta" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdConsulta" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-clipboard-x text-muted fs-1 mb-2"></i>
                <p class="text-muted">No se encontraron consultas registradas.</p>
                <a class="btn btn-outline-primary btn-sm" asp-action="Create">Registrar la primera consulta</a>
            </div>
        }
    </div>
</div>
