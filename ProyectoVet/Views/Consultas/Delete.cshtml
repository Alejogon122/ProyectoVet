@model ProyectoVet.Models.Consulta

@{
    ViewData["Title"] = "Eliminar Consulta";
}

<h1>@ViewData["Title"]</h1>

<h3>¿Seguro que desea eliminar esta consulta?</h3>

<div>
    <h4>Consulta</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.IdConsulta</dd>

        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.FechaConsulta</dd>

        <dt class="col-sm-2">Motivo</dt>
        <dd class="col-sm-10">@Model.MotivoConsulta</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="IdConsulta" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div>
