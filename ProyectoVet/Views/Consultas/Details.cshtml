@model ProyectoVet.Models.Consulta

@{
    ViewData["Title"] = "Detalles Consulta";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Consulta</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.IdConsulta</dd>

        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.FechaConsulta</dd>

        <dt class="col-sm-2">Motivo</dt>
        <dd class="col-sm-10">@Model.MotivoConsulta</dd>

        <dt class="col-sm-2">Síntomas</dt>
        <dd class="col-sm-10">@Model.Sintomas</dd>

        <dt class="col-sm-2">Diagnóstico</dt>
        <dd class="col-sm-10">@Model.Diagnostico</dd>

        <dt class="col-sm-2">Tratamiento</dt>
        <dd class="col-sm-10">@Model.TratamientoIndicado</dd>

        <dt class="col-sm-2">Peso (Kg)</dt>
        <dd class="col-sm-10">@Model.PesoKg</dd>

        <dt class="col-sm-2">Temperatura (C)</dt>
        <dd class="col-sm-10">@Model.TemperaturaC</dd>

        <dt class="col-sm-2">Observaciones</dt>
        <dd class="col-sm-10">@Model.Observaciones</dd>
    </dl>
</div>

<a class="btn btn-secondary" asp-action="Index">Volver</a>
