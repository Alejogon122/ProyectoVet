@model ProyectoVet.Models.Consulta

@{
    ViewData["Title"] = "Editar Consulta Médica";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-0 py-3">
                <h4 class="card-title fw-bold text-dark mb-0">
                    <i class="bi bi-pencil-square text-warning me-2"></i> Modificar Consulta Médica #@Model.IdConsulta
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="IdConsulta" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <!-- Datos Generales -->
                    <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">
                        <i class="bi bi-info-circle me-1"></i> Información General
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="IdExpediente" class="form-label fw-semibold">Expediente del Paciente *</label>
                            <select asp-for="IdExpediente" asp-items="ViewBag.IdExpediente" class="form-select" required></select>
                            <span asp-validation-for="IdExpediente" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IdVeterinario" class="form-label fw-semibold">Veterinario Responsable *</label>
                            <select asp-for="IdVeterinario" asp-items="ViewBag.IdVeterinario" class="form-select" required></select>
                            <span asp-validation-for="IdVeterinario" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IdCita" class="form-label fw-semibold">Cita Vinculada (Opcional)</label>
                            <select asp-for="IdCita" asp-items="ViewBag.IdCita" class="form-select">
                                <option value="">-- Sin cita previa (Atención directa) --</option>
                            </select>
                            <span asp-validation-for="IdCita" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaConsulta" class="form-label fw-semibold">Fecha y Hora de Consulta *</label>
                            <input asp-for="FechaConsulta" class="form-control" type="datetime-local" required />
                            <span asp-validation-for="FechaConsulta" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Signos Vitales -->
                    <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">
                        <i class="bi bi-activity me-1"></i> Constantes Fisiológicas
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="PesoKg" class="form-label fw-semibold">Peso (Kg)</label>
                            <div class="input-group">
                                <input asp-for="PesoKg" class="form-control" type="number" step="0.01" />
                                <span class="input-group-text">kg</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TemperaturaC" class="form-label fw-semibold">Temperatura (°C)</label>
                            <div class="input-group">
                                <input asp-for="TemperaturaC" class="form-control" type="number" step="0.1" />
                                <span class="input-group-text">°C</span>
                            </div>
                        </div>
                    </div>

                    <!-- Evaluación Médica -->
                    <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">
                        <i class="bi bi-file-medical me-1"></i> Evaluación Clínica
                    </h5>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="MotivoConsulta" class="form-label fw-semibold">Motivo de la Consulta *</label>
                            <input asp-for="MotivoConsulta" class="form-control" required />
                            <span asp-validation-for="MotivoConsulta" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Sintomas" class="form-label fw-semibold">Síntomas Reportados</label>
                            <textarea asp-for="Sintomas" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Diagnostico" class="form-label fw-semibold">Diagnóstico Clínico</label>
                            <textarea asp-for="Diagnostico" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="col-12">
                            <label asp-for="TratamientoIndicado" class="form-label fw-semibold">Tratamiento Indicado / Receta</label>
                            <textarea asp-for="TratamientoIndicado" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="col-12">
                            <label asp-for="Observaciones" class="form-label fw-semibold">Observaciones Adicionales</label>
                            <textarea asp-for="Observaciones" class="form-control" rows="2"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
